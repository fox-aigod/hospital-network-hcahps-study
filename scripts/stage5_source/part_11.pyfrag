fcontrast = pool_scalar(frac_contrast_est, frac_contrast_var)
sensitivity_rows.append({'analysis': 'Fractional logit average marginal effect', 'global_statistic': fglob['statistic'], 'global_df': fglob['df'],
                         'global_p': fglob['p_value'], 'contrast_estimate': fcontrast['estimate'], 'contrast_se': fcontrast['se'],
                         'contrast_ci_low': fcontrast['ci_low'], 'contrast_ci_high': fcontrast['ci_high'], 'contrast_p': fcontrast['p_value']})

# Complete-covariate unweighted OLS sensitivity
complete = np.array([as_int(r['complete_required_covariates']) == 1 for r in rows])
complete_idx = np.where((r_primary == 1) & complete)[0]
current0 = initial_imputation()
# observed values overwrite; complete rows have no missing required values
for name in current0:
    mask = ~np.isnan(orig[name]); current0[name][mask] = orig[name][mask]
complete_spec = make_standard_spec(np.where(complete)[0], include_interaction=False)
Xcc, names_cc = make_standard_design(current0, complete_spec, eval_idx=complete_idx)
bcc, ccc, _ = fit_ols(y_primary[complete_idx], Xcc, cov_type='HC3')
gcc = global_wald(bcc, ccc, names_cc, [t for t in profile_terms if t in names_cc])
j = names_cc.index('profile_5')
sej = math.sqrt(ccc[j,j])
contrast_cc = {'estimate': bcc[j], 'se': sej, 'ci_low': bcc[j]-1.95996398454*sej, 'ci_high': bcc[j]+1.95996398454*sej,
               'p_value': 2*(1-0.5*(1+math.erf(abs(bcc[j]/sej)/math.sqrt(2))))}
sensitivity_rows.append({'analysis': 'Unweighted complete-covariate complete case', 'global_statistic': gcc['statistic'], 'global_df': gcc['df'],
                         'global_p': gcc['p_value'], 'contrast_estimate': contrast_cc['estimate'], 'contrast_se': contrast_cc['se'],
                         'contrast_ci_low': contrast_cc['ci_low'], 'contrast_ci_high': contrast_cc['ci_high'], 'contrast_p': contrast_cc['p_value']})

# 2025-only sensitivity
idx_2025 = np.where(year2025 == 1)[0]
b25, c25 = [], []
names25 = None
for current in imputations:
    ow = observation_weights(current, idx_2025, r_primary, include_year=False)
    spec25 = make_standard_spec(idx_2025, include_interaction=False, include_year=False)
    X25, names25 = make_standard_design(current, spec25, eval_idx=ow['observed_idx'])
    b, c, _ = fit_wls(y_primary[ow['observed_idx']], X25, ow['weights'], cov_type='HC3')
    b25.append(b); c25.append(c)
sensitivity_rows.append(pooled_summary(b25, c25, profile_terms, names25, '2025 ONC responses only'))

# Exclude profile 0
idx_nozero = np.where(profile != 0)[0]
bnz, cnz = [], []
names_nz = None
for current in imputations:
    ow = observation_weights(current, idx_nozero, r_primary, profile_allowed=[1,2,3,4,5])
    specnz = make_standard_spec(idx_nozero, include_interaction=False, profile_allowed=[1,2,3,4,5])
    Xnz, names_nz = make_standard_design(current, specnz, eval_idx=ow['observed_idx'])
    b, c, _ = fit_wls(y_primary[ow['observed_idx']], Xnz, ow['weights'], cov_type='HC3')
    bnz.append(b); cnz.append(c)
sensitivity_rows.append(pooled_summary(bnz, cnz, [f'profile_{x}' for x in [1,2,4,5]], names_nz, 'Exclude all-zero coded profile'))

# Stratified analyses
stratified_rows = []
for g, glabel in [(0,'Acute Care'),(1,'Critical Access')]:
    idxg = np.where(cah == g)[0]
    bgs, cgs = [], []
    namesg = None
    for current in imputations:
        ow = observation_weights(current, idxg, r_primary, include_cah=False)
