def read_csv(path):
    with path.open('r', encoding='utf-8-sig', newline='') as f:
        return list(csv.DictReader(f))


def write_csv(path, rows, fieldnames=None):
    if not rows:
        path.write_text('', encoding='utf-8')
        return
    if fieldnames is None:
        fieldnames = list(rows[0])
    with path.open('w', encoding='utf-8', newline='') as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        w.writerows(rows)


def fnum(v):
    try:
        return float(v)
    except Exception:
        return np.nan


def as_int(v, default=0):
    try:
        return int(float(v))
    except Exception:
        return default


def expit(x):
    x = np.clip(x, -35, 35)
    return 1.0 / (1.0 + np.exp(-x))


rows = read_csv(INPUT)
n = len(rows)
idx_all = np.arange(n)
states_all = sorted(set(r['state'] for r in rows))
profile = np.array([as_int(r['profile_category_code']) for r in rows], dtype=int)
